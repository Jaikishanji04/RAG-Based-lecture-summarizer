# Hugging Face Inference Provider Configuration
HF_TOKEN=your_huggingface_access_token_here
HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_EMBED_MODEL=BAAI/bge-small-en-v1.5
HF_BASE_URL=https://router.huggingface.co/hf-inference/v1

# Generation settings
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=180

# Speech-to-text (Whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_GPU_COMPUTE_TYPE=float16

# Reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Gmail MCP Configuration (OAuth Read-Only)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
MCP_SERVER_COMMAND=
MCP_MAX_AGENT_STEPS=8

# Optional: browser cookies for yt-dlp
YTDLP_COOKIES_FROM_BROWSER=
